---
export interface Props {
	coverImg: any;
	linkUrl: string;
	title: string;
	blurb: string;
	sampleUrl?: string;
	buttonText: string;
}
import { Image } from 'astro:assets';
const { coverImg, linkUrl, title, blurb, sampleUrl, buttonText } = Astro.props;
---

<article
	class="mt-6 flex items-center justify-center overflow-hidden rounded-2xl bg-amber-100 pr-4 shadow-sm ring-1 ring-amber-200 sm:pr-6 lg:pr-10"
>
	{
		coverImg && (
			<figure class="w-[25%] lg:w-[30%]">
				<a href={linkUrl}>
					<Image class="rounded-l-3xl" src={coverImg} alt={title} />
				</a>
			</figure>
		)
	}
	<div class="flex flex-grow flex-col px-6 py-3">
		<h3 class="font-serif text-xl leading-tight font-bold sm:text-2xl">
			<a class="hover:text-teal-800" href={linkUrl}>{title}</a>
		</h3>
		<p class="py-3">{blurb}</p>
		<div class="flex flex-wrap justify-end gap-2">
			<a href={linkUrl} class="button-link">{buttonText}</a>
			{
				sampleUrl && (
					<a
						href={sampleUrl}
						class="button-link !bg-white !text-teal-900 ring-1 ring-teal-700 hover:!bg-teal-50"
					>
						read a sample
					</a>
				)
			}
		</div>
	</div>
</article>
