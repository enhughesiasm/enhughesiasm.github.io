---
import { getBlogPosts } from './api/fetch_articles';
import RecentArticleCard from './RecentArticleCard.astro';

const posts = getBlogPosts().slice(0, 4);
---

<div class="hidden space-y-6 md:block">
	<!-- <div
		class='items-center justify-center space-x-6 text-center font-serif text-xl'
	>
		<span class='text-3xl'>🗣️</span> Recent posts:
	</div> -->
	<div
		class="mx-auto flex flex-row flex-wrap items-center justify-center space-x-12 gap-y-6 text-center"
	>
		<div class="text-6xl">
			<a href={`${import.meta.env.BASE_URL}articles`}>🗣️</a>
		</div>
		{
			posts.map((post) => (
				<RecentArticleCard post={{ ...post, categories: [] }} />
			))
		}
		<div class="text-6xl">
			<a href={`${import.meta.env.BASE_URL}articles`}>...</a>
		</div>
	</div>
</div>
