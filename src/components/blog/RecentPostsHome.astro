---
import { getBlogPosts } from './api/fetch_articles';
import RecentArticleCard from './RecentArticleCard.astro';

const posts = getBlogPosts().slice(0, 4);
---

<section aria-labelledby="recent-writing">
	<div class="mb-6 flex items-end justify-between gap-4">
		<div>
			<p class="eyebrow">From the notebook</p>
			<h2 id="recent-writing" class="section-title">Recent articles</h2>
		</div>
		<a
			class="text-link hidden sm:inline"
			href={`${import.meta.env.BASE_URL}articles`}>All articles →</a
		>
	</div>
	<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
		{
			posts.map((post) => (
				<RecentArticleCard post={{ ...post, categories: [] }} />
			))
		}
	</div>
	<a
		class="text-link mt-6 inline-block sm:hidden"
		href={`${import.meta.env.BASE_URL}articles`}>All articles →</a
	>
</section>
