---
import Nav from '../nav/Nav.astro';
import { RandomSubtitle } from './random_subtitle';
---

<header class="bg-zinc-950 text-white">
	<div class="site-shell flex min-h-20 items-center justify-between gap-6">
		<div class="min-w-0 py-3 font-serif">
			<a
				href={`${import.meta.env.BASE_URL}`}
				class="block text-xl leading-tight font-bold text-yellow-400 no-underline hover:text-yellow-300 lg:text-2xl"
			>
				walking on custard
			</a>
			<div class="hidden text-xs leading-snug text-zinc-300 lg:block">
				<RandomSubtitle client:load />
			</div>
		</div>
		<Nav />
	</div>
</header>
