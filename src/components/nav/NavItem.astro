---
interface Props {
	text: string;
	link: string;
	className?: string;
}

import { Pacman } from 'iconoir-react';

const { link, text, className = '' } = Astro.props;

const { url } = Astro;

const isActive =
	(link === import.meta.env.BASE_URL &&
		url.pathname === import.meta.env.BASE_URL) ||
	(link !== import.meta.env.BASE_URL && url.pathname.startsWith(link));
---

<li class={`group relative flex h-full items-stretch ${className}`}>
	<a
		aria-current={isActive ? 'page' : undefined}
		class={`flex items-center gap-2 border-b-4 px-3 text-sm no-underline transition-colors lg:px-4 lg:text-base ${isActive ? 'border-yellow-400 bg-zinc-900 text-yellow-300' : 'border-transparent text-zinc-100 hover:border-zinc-600 hover:bg-zinc-900 hover:text-yellow-300'}`}
		href={link}
	>
		<span
			class="hidden h-5 w-5 shrink-0 place-items-center xl:grid [&_svg]:h-5 [&_svg]:w-5 [&>*]:col-start-1 [&>*]:row-start-1"
		>
			<span class="grid place-items-center group-hover:invisible"
				><slot name="icon" /></span
			>
			<Pacman
				className="invisible h-5 w-5 text-yellow-400 group-hover:visible"
			/>
		</span>
		<span>{text}</span></a
	>
	<ul
		class="absolute top-full left-0 z-20 hidden h-auto border-t-4 border-t-yellow-400 group-focus-within:block group-hover:block"
	>
		<slot name="dropdown-items" />
	</ul>
</li>
