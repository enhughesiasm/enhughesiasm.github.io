---
interface Props {
	text: string;
	link: string;
}

const { link, text } = Astro.props;

const { url } = Astro;

const isActive =
	(link === import.meta.env.BASE_URL &&
		url.pathname === import.meta.env.BASE_URL) ||
	(link !== import.meta.env.BASE_URL && url.pathname.startsWith(link));
---

<li
	class="group/dropdown relative z-50 flex h-full min-w-64 items-center justify-center bg-zinc-800 hover:bg-zinc-700"
>
	<a
		class="flex h-full w-full flex-grow items-center gap-3 px-4 py-3 text-left text-sm whitespace-nowrap"
		href={link}
	>
		<span class="">
			<span
				class={`group/dropdown-hover:hidden ${
					isActive ? 'text-yellow-500' : ''
				}`}><slot name="icon" /></span
			>
		</span>
		<span class={`${isActive ? 'text-emerald-300' : 'text-white'}`}>{text}</span
		></a
	>
</li>
