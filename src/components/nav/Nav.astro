---
import {
	Arcade,
	BookStack,
	ChatBubble,
	CrackedEgg,
	Mail,
	MessageText,
	MultiplePages,
	PeopleTag,
	ShopFourTiles,
	Treadmill,
} from 'iconoir-react';
import DropdownItem from './DropdownItem.astro';
import NavItem from './NavItem.astro';
import { MobileNav } from './mobile_nav';
---

<MobileNav currentPath={Astro.url.pathname} client:load />

<nav aria-label="Main navigation" class="hidden self-stretch md:flex">
	<ul class="flex items-stretch">
		<NavItem text="home" link={`${import.meta.env.BASE_URL}`}>
			<PeopleTag slot="icon" />
		</NavItem>
		<NavItem text="articles" link={`${import.meta.env.BASE_URL}articles`}>
			<MultiplePages slot="icon" />
		</NavItem>
		<NavItem text="anxiety" link={`${import.meta.env.BASE_URL}anxiety`}>
			<Treadmill slot="icon" />
		</NavItem>
		<NavItem text="books" link={`${import.meta.env.BASE_URL}books`}>
			<BookStack slot="icon" />
			<Fragment slot="dropdown-items">
				<DropdownItem
					text="Walking on Custard"
					link={`${import.meta.env.BASE_URL}books/walking-on-custard`}
				>
					<CrackedEgg slot="icon" />
				</DropdownItem>
				<DropdownItem
					text="The Shop Before Life"
					link={`${import.meta.env.BASE_URL}books/shop-before-life`}
				>
					<ShopFourTiles slot="icon" />
				</DropdownItem>
			</Fragment>
		</NavItem>
		<NavItem
			text="games"
			link={`${import.meta.env.BASE_URL}games`}
			className="hidden xl:flex"
		>
			<Arcade slot="icon" />
			<Fragment slot="dropdown-items">
				<DropdownItem
					text="The Supplier's Complex"
					link="https://walkingoncustard.com/complex"
				>
					<ShopFourTiles slot="icon" />
				</DropdownItem>
			</Fragment>
		</NavItem>
		<NavItem
			text="speaking"
			link={`${import.meta.env.BASE_URL}speaking`}
			className="hidden lg:flex"
		>
			<ChatBubble slot="icon" />
		</NavItem>
		<NavItem
			text="emails"
			link={`${import.meta.env.BASE_URL}occasional-email-experience`}
		>
			<Mail slot="icon" />
		</NavItem>
		<NavItem text="contact" link={`${import.meta.env.BASE_URL}contact`}>
			<MessageText slot="icon" />
		</NavItem>
	</ul>
</nav>
