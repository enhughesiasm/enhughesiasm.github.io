---
import { Image } from 'astro:assets';
import neilHeadshot from '../../../assets/images/neil_hughes_headshot_al.jpg';
---

<div
	transition:name="page-title"
	class="overflow-hidden rounded-2xl bg-violet-100 shadow-sm md:grid md:grid-cols-[13rem_1fr]"
>
	<Image
		class="h-36 w-full object-cover object-[center_25%] md:h-full"
		src={neilHeadshot}
		alt="Neil Hughes"
	/>
	<div
		class="flex flex-col justify-center px-6 py-7 text-center md:px-10 md:text-left"
	>
		<p class="eyebrow mb-2">Welcome to the online home of</p>
		<h1 class="font-serif text-3xl leading-tight font-bold md:text-4xl">
			Neil Hughes
		</h1>
		<p class="mt-2 max-w-2xl text-base text-zinc-700 md:text-lg">
			I write, speak, and make things. Currently...
		</p>
	</div>
</div>
