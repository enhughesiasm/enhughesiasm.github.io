---
let currentYear = new Date().getFullYear();

const isProd = import.meta.env.PROD;
---

<footer class="mt-16 bg-yellow-200 text-zinc-950">
	<div
		class="site-shell flex flex-col items-center gap-5 py-8 text-center sm:flex-row sm:justify-between sm:text-left"
	>
		<div class="">
			&copy; Neil Hughes 2019
			{currentYear !== 2019 ? '— ' + currentYear : ''}
		</div>
		<div class="inline-flex flex-row items-center justify-center">
			<a
				target="_blank"
				rel="noopener noreferrer"
				href="https://www.buymeacoffee.com/enhughesiasm"
			>
				<span
					class="inline-flex min-h-11 flex-row items-center rounded-full bg-zinc-800 px-4 py-2 font-bold text-yellow-400 hover:bg-zinc-700"
				>
					<img
						style={{ width: '18px' }}
						src="https://cdn.buymeacoffee.com/buttons/bmc-new-btn-logo.svg"
						alt="Buy me a coffee"
					/>
					<span style={{ marginLeft: '12px', fontSize: '17px' }}>
						Buy me a coffee
					</span>
				</span>
			</a>
		</div>
		<nav aria-label="Footer navigation" class="space-x-8">
			<a
				href={`${import.meta.env.BASE_URL}contact`}
				class="underline decoration-zinc-400 hover:text-zinc-600"
			>
				contact</a
			>
			<a
				href={`${import.meta.env.BASE_URL}privacy`}
				class="underline decoration-zinc-400 hover:text-zinc-600"
			>
				privacy</a
			>
		</nav>
	</div>
	{
		isProd && (
			<script
				is:inline
				async
				defer
				data-name="BMC-Widget"
				src="https://cdnjs.buymeacoffee.com/1.0.0/widget.prod.min.js"
				data-id="enhughesiasm"
				data-description=""
				data-message=""
				data-color="#5F7FFF"
				data-position="left"
				data-x_margin="18"
				data-y_margin="18"
			/>
		)
	}
</footer>
