---
import AnxietyArticleCard from './AnxietyArticleCard.astro';
import { getBlogPosts } from '../blog/api/fetch_articles';

const groups = [
	{
		title: 'Start here',
		description: 'A few useful first steps when anxiety arises.',
		ids: ['2813', '2440', '3378'],
	},
	{
		title: 'Spot patterns',
		description: 'Tips to untangle worries.',
		ids: ['2979', '2291', '3077', '2589', '2580'],
	},
	{
		title: 'Keep moving',
		description: 'Experiments for difficult days.',
		ids: ['3116', '635', '2514', '1935', '2361', '1818'],
	},
];

const allArticles = getBlogPosts();
const articleById = new Map(
	allArticles.map((article) => [article.id.toString(), article]),
);
---

<section aria-labelledby="anxiety-library">
	<h2 id="anxiety-library" class="section-title mb-8 text-center">
		The Anxiety Library
	</h2>
	<div class="grid gap-6 md:grid-cols-3">
		{
			groups.map((group) => (
				<section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-zinc-200">
					<h3 class="font-serif text-xl font-bold">{group.title}</h3>
					<p class="mt-2 text-sm leading-relaxed text-zinc-600">
						{group.description}
					</p>
					<ul class="mt-5 space-y-4">
						{group.ids
							.map((id) => articleById.get(id))
							.filter(Boolean)
							.map(
								(article) => article && <AnxietyArticleCard post={article} />,
							)}
					</ul>
				</section>
			))
		}
	</div>
</section>
