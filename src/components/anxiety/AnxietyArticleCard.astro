---
import type { PostV2 } from '../blog/api/post';

export interface Props {
	post: PostV2;
}

const { post } = Astro.props;

const BASE_ARTICLE_URL = `${import.meta.env.BASE_URL}articles/`;
---

<li>
	<a
		href={`${BASE_ARTICLE_URL}${post.slug}`}
		class="text-link block text-sm leading-snug"
	>
		<Fragment set:html={post.title} />
		<span aria-hidden="true">→</span>
	</a>
</li>
