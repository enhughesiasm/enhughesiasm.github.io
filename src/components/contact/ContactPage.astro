---
import { SendMail } from 'iconoir-react';
---

<h1
	transition:name="page-title"
	class="rounded-2xl bg-blue-200 px-6 py-8 text-center font-serif text-3xl font-bold"
>
	<SendMail className="inline" /> Get in contact
</h1>

<div class="mx-auto max-w-2xl space-y-4 py-8 text-center">
	<p>
		<span class="font-bold text-teal-700">Email is welcome!</span> I read every email
		and reply to as many as I can.
	</p>
	<p>
		Solve this little anti-bot puzzle to send an email directly to: <em
			class="font-serif text-teal-700"
		>
			neil <strong>at</strong> walkingoncustard{' '}
			<strong>dot</strong> com
		</em>
	</p>
</div>

