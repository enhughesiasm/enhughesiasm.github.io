{
	"name": "@walkingoncustard/homepage",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"check": "astro check",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"format": "prettier --write \"src/**/*.{astro,css,ts,tsx}\" \"*.{cjs,js,json,mjs}\" \".github/**/*.{yaml,yml}\"",
